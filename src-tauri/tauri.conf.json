{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "聽譯",
  "version": "0.1.3",
  "identifier": "com.jerry.tingyi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "聽譯 tingyi",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "聽譯字幕",
        "url": "overlay.html",
        "width": 1100,
        "height": 230,
        "x": 200,
        "y": 780,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OURDODBBMEY4MjMwOEYKUldTUE1JSVBDc2lkZGxPMEcrOFdIMTRXb3JJYlhEeVBHTC9LUmNiQ0hOTXdSLzVxWnlZU04yeG4K",
      "endpoints": [
        "https://github.com/Hsiung-Shao/tingyi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
