{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-translator",
  "mainBinaryName": "atx-app",
  "version": "0.1.0",
  "identifier": "com.jerry.agent-translator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm -w --filter @atx/bridge build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "agent-translator 本機翻譯",
        "width": 560,
        "height": 680,
        "minWidth": 480,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../bridge/dist/bridge.mjs": "bridge.mjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
