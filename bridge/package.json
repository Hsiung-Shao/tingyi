{
  "name": "@atx/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/bridge.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "pnpm build && node dist/bridge.mjs"
  },
  "dependencies": {
    "@atx/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
